{
  "name": "typescript-full-mastery-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Companion code for the TypeScript Full Mastery 120-part series.",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "stats": "node scripts/report-stats.mjs",
    "verify": "npm run verify:structure && npm run verify:docs && npm run check && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanskarIN/ts-mastery.git"
  },
  "homepage": "https://github.com/sanskarIN/ts-mastery#readme",
  "funding": "https://ramsandesh.gumroad.com",
  "bugs": {
    "url": "https://github.com/sanskarIN/ts-mastery/issues"
  }
}
